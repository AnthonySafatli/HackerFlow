@page
@model IndexModel

@{
    ViewData["Title"] = "Resume";
}

<div>
    <!-- Page header -->
    <div class="d-flex flex-column flex-lg-row
        justify-content-between align-items-lg-center
        gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Resume Manager</h1>
            <p class="text-secondary mb-0">
                Store all versions of your resume.
            </p>
        </div>

        <button type="button" id="newApplicationButton" class="btn btn-hf-primary px-4" data-bs-toggle="modal"
                data-bs-target="#newApplicationModal">
            New Resume <span class="ms-1">+</span>
        </button>
    </div>

    <div>
        <form method="post" asp-page-handler="ResumeFolder" class="mb-3">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="resumeFolder" class="col-form-label">Resume Folder</label>
                </div>
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text">
                            <img src="~/lib/bootstrap-icons/folder2.svg" alt="Folder2">
                        </span>
                        <input asp-for="ResumeFolder" id="resumeFolder" class="form-control" placeholder="~/Resumes" />
                        <button type="submit" class="btn btn-hf-primary">Save</button>
                    </div>
                </div>
            </div>
        </form>

        <form method="post" asp-page-handler="GeneratedFolder" class="mb-3">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="generatedFolder" class="col-form-label">Generated Resume Folder</label>
                </div>
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text">
                            <img src="~/lib/bootstrap-icons/folder-plus.svg" alt="FolderPlus">
                        </span>
                        <input asp-for="GeneratedResumeFolder" id="generatedFolder" class="form-control"
                               placeholder="~/Resumes/Generated" />
                        <button type="submit" class="btn btn-hf-primary">Save</button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Applications table -->
    <div class="card hf-card">
        <div class="table-responsive">

            <table id="applicationsTable" class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Version</th>
                        <th scope="col">Path</th>
                        <th scope="col">Date Created</th>
                        <th scope="col">Notes</th>
                        <th scope="col" class="text-end">
                            <span class="visually-hidden">Actions</span>
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var resume in Model.Resumes)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    @resume.Name
                                </span>
                            </td>

                            <td>
                                <span class="fw-medium">
                                    @resume.Version
                                </span>
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @resume.CreatedAt.ToString("MMM d, yyyy")
                                </span>
                            </td>

                            <td>
                                <span class="text-secondary">
                                    <a action="" href="file://@resume.FilePath" target="_blank" rel="noopener noreferrer"
                                       class="small text-secondary text-decoration-none">
                                        @resume.FilePath
                                    </a>
                                </span>
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @resume.Notes
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-danger application-delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteApplicationModal-@resume.Id">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>