@page
@model IndexModel

@{
    ViewData["Title"] = "Tracker";
}

<div class="tracker-page">

    <!-- Page header -->
    <div class="d-flex flex-column flex-lg-row
        justify-content-between align-items-lg-center
        gap-3 mb-4">

        <div>
            <h1 class="h3 mb-1">Application Tracker</h1>
            <p class="text-secondary mb-0">
                Keep your job search moving.
            </p>
        </div>

        <button type="button" id="newApplicationButton" class="btn btn-hf-primary px-4">
            New Application <span class="ms-1">+</span>
        </button>

    </div>


    <!-- Application pipeline -->
    <div class="application-pipeline mb-4">

        <a href="#" class="pipeline-step active" data-status="all">
            <span>All</span>
        </a>

        <a href="#" class="pipeline-step" data-status="bookmarked">
            <span>Bookmarked</span>
        </a>

        <a href="#" class="pipeline-step" data-status="applying">
            <span>Applying</span>
        </a>

        <a href="#" class="pipeline-step" data-status="applied">
            <span>Applied</span>
        </a>

        <a href="#" class="pipeline-step" data-status="interviewing">
            <span>Interviewing</span>
        </a>

        <a href="#" class="pipeline-step" data-status="negotiating">
            <span>Negotiating</span>
        </a>

        <a href="#" class="pipeline-step last" data-status="accepted">
            <span>Accepted</span>
        </a>

    </div>


    <!-- Applications table -->
    <div class="card hf-card">

        <div class="table-responsive">
            <table id="applicationsTable" class="table table-dark table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th scope="col">Company</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Date Applied</th>
                        <th scope="col">Method</th>
                        <th scope="col">Contact</th>
                        <th scope="col">Notes</th>
                        <th scope="col" class="text-end">
                            <span class="visually-hidden">Actions</span>
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var application in Model.Applications)
                    {
                        <tr data-status="@application.Status.ToLowerInvariant()">
                            <td>
                                <div class="fw-semibold">
                                    @application.Company
                                </div>

                                <a href="@application.Url" target="_blank" rel="noopener noreferrer"
                                   class="small text-secondary text-decoration-none">
                                    @application.Url
                                </a>
                            </td>

                            <td>
                                <span class="fw-medium">
                                    @application.Role
                                </span>
                            </td>

                            <td>
                                <span class="badge hf-status hf-status-@application.Status.ToLowerInvariant()">
                                    @application.Status
                                </span>
                            </td>

                            <td>
                                @if (application.DateApplied.HasValue)
                                {
                                    <span class="text-secondary">
                                        @application.DateApplied.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @application.Method
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(application.Contact))
                                {
                                    <span class="text-secondary">
                                        @application.Contact
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @application.Notes
                                </span>
                            </td>

                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary application-details"
                                        data-application-id="@application.Company">
                                    Open
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>

<partial name="_ApplicationModal" />

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}