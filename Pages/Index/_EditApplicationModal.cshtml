@model HackerFlow.ViewModels.ApplicaitonEditModalVM

@{
    var statusOptions = new string[] {
        "Bookmarked",
        "Applying",
        "Applied",
        "Interviewing",
        "Offered",
        "Accepted",
        "Rejected",
        "Archived"
    };
}

<div class="modal fade" id="editApplicationModal-@Model.JobApplicaiton.Id" tabindex="-1"
     aria-labelledby="editApplicationModalLabel-@Model.JobApplicaiton.Id" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content hf-modal">

            <form asp-page-handler="Update" method="post">
                <input type="hidden" name="UpdateInput.Id" value="@Model.JobApplicaiton.Id" />
                <input type="hidden" name="UpdateInput.ResumePath" value="@Model.JobApplicaiton.ResumePath" />
                <input type="hidden" name="UpdateInput.CoverLetterPath" value="@Model.JobApplicaiton.CoverLetterPath" />

                <div class="modal-header">
                    <h5 class="modal-title" id="editApplicationModalLabel-@Model.JobApplicaiton.Id">
                        Edit Application — @Model.JobApplicaiton.Company.Name
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <ul class="nav nav-tabs hf-modal-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="edit-details-tab-@Model.JobApplicaiton.Id"
                                    data-bs-toggle="tab" data-bs-target="#edit-details-pane-@Model.JobApplicaiton.Id"
                                    type="button" role="tab" aria-controls="edit-details-pane-@Model.JobApplicaiton.Id"
                                    aria-selected="true">
                                Details
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="edit-jobdesc-tab-@Model.JobApplicaiton.Id" data-bs-toggle="tab"
                                    data-bs-target="#edit-jobdesc-pane-@Model.JobApplicaiton.Id" type="button" role="tab"
                                    aria-controls="edit-jobdesc-pane-@Model.JobApplicaiton.Id" aria-selected="false">
                                Job Description
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">

                        <!-- Details tab -->
                        <div class="tab-pane fade show active" id="edit-details-pane-@Model.JobApplicaiton.Id"
                             role="tabpanel" aria-labelledby="edit-details-tab-@Model.JobApplicaiton.Id">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="editApp-company-@Model.JobApplicaiton.Id"
                                           class="form-label">Company</label>
                                    <input type="text" class="form-control"
                                           id="editApp-company-@Model.JobApplicaiton.Id" name="UpdateInput.Company"
                                           value="@Model.JobApplicaiton.Company.Name" required list="existingCompanies" />
                                    <datalist id="existingCompanies">
                                        @foreach (var company in Model.Companies)
                                        {
                                            <option value="@company" />
                                        }
                                    </datalist>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="editApp-role-@Model.JobApplicaiton.Id" class="form-label">Role</label>
                                    <input type="text" class="form-control" id="editApp-role-@Model.JobApplicaiton.Id"
                                           name="UpdateInput.Role" value="@Model.JobApplicaiton.Role" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="editApp-url-@Model.JobApplicaiton.Id" class="form-label">Job Posting
                                    URL</label>
                                    <input type="url" class="form-control" id="editApp-url-@Model.JobApplicaiton.Id"
                                           name="UpdateInput.Url" value="@Model.JobApplicaiton.Url" placeholder="https://"
                                           required />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="editApp-status-@Model.JobApplicaiton.Id"
                                               class="form-label">Status</label>
                                        <select class="form-select" id="editApp-status-@Model.JobApplicaiton.Id"
                                                name="UpdateInput.Status">
                                            @for (int i = 0; i < statusOptions.Length; i++)
                                            {
                                                <option value="@(i)" selected="@((int)Model.JobApplicaiton.Status == i)">
                                                    @statusOptions[i]
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="editApp-method-@Model.JobApplicaiton.Id"
                                               class="form-label">Method</label>
                                        <input type="text" class="form-control" id="editApp-method-@Model.JobApplicaiton.Id"
                                               name="UpdateInput.Method" value="@Model.JobApplicaiton.Method"
                                               list="applicationMethods-@Model.JobApplicaiton.Id" required />
                                        <datalist id="applicationMethods-@Model.JobApplicaiton.Id">
                                            <option value="Company site" />
                                            <option value="LinkedIn" />
                                            <option value="Referral" />
                                            <option value="Job board" />
                                            <option value="Email" />
                                        </datalist>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="editApp-dateApplied-@Model.JobApplicaiton.Id" class="form-label">Date
                                            Applied</label>
                                            <input type="date" class="form-control"
                                                   id="editApp-dateApplied-@Model.JobApplicaiton.Id" name="UpdateInput.DateApplied"
                                                   value="@(Model.JobApplicaiton.DateApplied?.ToString("yyyy-MM-dd"))" />
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label for="editApp-followUpDate-@Model.JobApplicaiton.Id" class="form-label">
                                                Follow-up Date
                                            </label>
                                            <input type="date" class="form-control"
                                                   id="editApp-followUpDate-@Model.JobApplicaiton.Id"
                                                   name="UpdateInput.FollowUpDate"
                                                   value="@(Model.JobApplicaiton.FollowUpDate?.ToString("yyyy-MM-dd"))" />
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="editApp-connection-@Model.JobApplicaiton.Id"
                                               class="form-label">Connection</label>
                                        <input type="text" class="form-control" id="editApp-connection-@Model.JobApplicaiton.Id"
                                               name="UpdateInput.Connection" value="@Model.JobApplicaiton.Connection"
                                               list="existingConnections" />
                                        <datalist id="existingConnections">
                                            @foreach (var connection in Model.Connections)
                                            {
                                                <option value="@connection" />
                                            }
                                        </datalist>
                                    </div>

                                    <div class="mb-3">
                                        <label for="editApp-notes-@Model.JobApplicaiton.Id" class="form-label">Notes</label>
                                        <textarea class="form-control" id="editApp-notes-@Model.JobApplicaiton.Id"
                                                  name="UpdateInput.Notes" rows="3">@Model.JobApplicaiton.Notes</textarea>
                                    </div>

                                    <hr class="border-secondary" />

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label text-secondary">Resume</label>
                                            <input type="text" class="form-control" disabled
                                                   value="@(string.IsNullOrWhiteSpace(Model.JobApplicaiton.ResumePath) ? "Not generated yet" : Model.JobApplicaiton.ResumePath)" />
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label text-secondary">Cover Letter</label>
                                            <input type="text" class="form-control" disabled
                                                   value="@(string.IsNullOrWhiteSpace(Model.JobApplicaiton.CoverLetterPath) ? "Not generated yet" : Model.JobApplicaiton.CoverLetterPath)" />
                                        </div>
                                    </div>

                                </div>

                                <!-- Job description tab -->
                                <div class="tab-pane fade" id="edit-jobdesc-pane-@Model.JobApplicaiton.Id" role="tabpanel"
                                     aria-labelledby="edit-jobdesc-tab-@Model.JobApplicaiton.Id">

                                    <div class="mb-3">
                                        <label for="editApp-jobdesc-@Model.JobApplicaiton.Id" class="form-label">Job
                                            Description</label>
                                            <textarea class="form-control" id="editApp-jobdesc-@Model.JobApplicaiton.Id"
                                                      name="UpdateInput.JobDescription"
                                                      rows="14">@Model.JobApplicaiton.JobDescription</textarea>
                                        </div>

                                    </div>

                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-hf-primary">Save Changes</button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>