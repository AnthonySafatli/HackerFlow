@page "/"
@using HackerFlow.ViewModels
@model IndexModel

@{
    ViewData["Title"] = "Tracker";
}

<div>
    <!-- Page header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <h1 class="h3 mb-1">Application Tracker</h1>
            <p class="text-secondary mb-0">
                Keep your job search moving.
            </p>
        </div>

        <div class="d-flex gap-2">
            <div>
                <partial name="_ActionButton" model="@(new ActionButtonVM
                         {
                             Label = $" Purge Packages",
                             CssClass = "btn-outline-danger px-4",
                             Url = $"/api/applications/packages",
                             Method = "DELETE",
                         })" />
            </div>

            <button type="button" id="newApplicationButton" class="btn btn-hf-primary px-4" data-bs-toggle="modal"
                    data-bs-target="#newApplicationModal">
                New Application <span class="ms-1">+</span>
            </button>
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mt-4"></div>

    <!-- Application pipeline -->
    <partial name="_ApplicationPipeline" model="Model.Applications.Select(x => x.Status.ToString()).ToList()" />

    <!-- Applications table -->
    <div class="card hf-card">
        <div class="table-responsive">

            <table id="applicationsTable" class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Company</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Date Applied</th>
                        <th scope="col">Method</th>
                        <th scope="col">Connection</th>
                        <th scope="col">Notes</th>
                        <th scope="col" class="text-end">
                            <span class="visually-hidden">Actions</span>
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var application in Model.Applications)
                    {
                        Uri.TryCreate(application.Url, UriKind.Absolute, out var uri);
                        string origin = uri?.GetLeftPart(UriPartial.Authority) ?? application.Url;
                        if (uri != null)
                            origin += "/...";

                        <tr class="pointer" data-status="@application.Status.ToString().ToLowerInvariant()"
                            data-bs-toggle="modal" data-bs-target="#detailsApplicationModal-@application.Id">
                            <td>
                                <div class="fw-semibold">
                                    @application.Company.Name
                                </div>

                                <a href="@application.Url" target="_blank" rel="noopener noreferrer"
                                   onclick="event.stopPropagation()" class="small text-secondary text-decoration-none">
                                    @origin
                                </a>
                            </td>

                            <td>
                                <span class="fw-medium">
                                    @application.Role
                                </span>
                            </td>

                            <td>
                                <span class="badge hf-status hf-status-@application.Status.ToString().ToLowerInvariant()">
                                    @application.Status.ToString()
                                </span>
                            </td>

                            <td>
                                @if (application.DateApplied.HasValue)
                                {
                                    <span class="text-secondary">
                                        @application.DateApplied.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @application.Method
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(application.Connection?.Name))
                                {
                                    <span class="text-secondary">
                                        @application.Connection.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @application.Notes
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary application-edit"
                                            onclick="event.stopPropagation()" data-bs-toggle="modal" data-bs-toggle="modal"
                                            data-bs-target="#editApplicationModal-@application.Id">
                                        Edit
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_NewApplicationModal" />

    @foreach (var application in Model.Applications)
    {
        var detailsVm = new ApplicaitonDetailsModalVM
        {
            JobApplicaiton = application,
            ResumeGroups = Model.ResumeGroups,
            CoverLetterGroups = Model.CoverLetterGroups,
            Prompts = Model.Prompts,
        };

        var editVm = new ApplicaitonEditModalVM
        {
            JobApplicaiton = application,
            Companies = Model.Companies,
            Connections = Model.Connections,
        };

        <partial name="_EditApplicationModal" model="editVm" />
        <partial name="_ApplicationDetailsModal" model="detailsVm" />
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pipeline.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pipeline.js" asp-append-version="true"></script>
    <script src="~/js/action-button.js" asp-append-version="true"></script>
    <script src="~/js/action-handler.js" asp-append-version="true"></script>
}