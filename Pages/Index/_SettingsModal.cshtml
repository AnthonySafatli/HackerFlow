@model Venture.ViewModels.SettingsVM

<div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content hf-modal">
            <form id="settingsForm" asp-page-handler="SaveSettings" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="settingsModalLabel">Settings</h5>
                    <span class="badge hf-unsaved ms-3" id="settingsUnsaved" hidden>⚠ Unsaved changes</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3 hf-field">
                        <label for="settings-packageOutputPath" class="form-label">Package Output Path</label>
                        <input type="text" class="form-control" id="settings-packageOutputPath"
                               name="SettingsInput.PackageOutputPath" value="@Model.PackageOutputPath" required />
                        <div class="form-text">Where generated application packages are saved.</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-hf-primary" id="settingsSave" disabled>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>