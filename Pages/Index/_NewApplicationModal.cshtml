<div class="modal fade" id="newApplicationModal" tabindex="-1" aria-labelledby="newApplicationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content hf-modal">

            <form asp-page="/Index" asp-page-handler="Create" method="post">

                <div class="modal-header">
                    <h5 class="modal-title" id="newApplicationModalLabel">New Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="newApp-company" class="form-label">Company</label>
                        <input type="text" class="form-control" id="newApp-company" name="Application.Company" required />
                    </div>

                    <div class="mb-3">
                        <label for="newApp-role" class="form-label">Role</label>
                        <input type="text" class="form-control" id="newApp-role" name="Application.Role" required />
                    </div>

                    <div class="mb-3">
                        <label for="newApp-url" class="form-label">Job Posting URL</label>
                        <input type="url" class="form-control" id="newApp-url" name="Application.Url" placeholder="https://" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="newApp-status" class="form-label">Status</label>
                            <select class="form-select" id="newApp-status" name="Application.Status">
                                <option value="Bookmarked" selected>Bookmarked</option>
                                <option value="Applying">Applying</option>
                                <option value="Applied">Applied</option>
                                <option value="Interviewing">Interviewing</option>
                                <option value="Negotiating">Negotiating</option>
                                <option value="Accepted">Accepted</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="newApp-method" class="form-label">Method</label>
                            <input type="text" class="form-control" id="newApp-method" name="Application.Method"
                                   list="applicationMethods" placeholder="Company site, LinkedIn..." />
                            <datalist id="applicationMethods">
                                <option value="Company site" />
                                <option value="LinkedIn" />
                                <option value="Referral" />
                                <option value="Job board" />
                                <option value="Email" />
                            </datalist>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="newApp-contact" class="form-label">Contact</label>
                        <input type="text" class="form-control" id="newApp-contact" name="Application.Contact" />
                    </div>

                    <div class="mb-3">
                        <label for="newApp-notes" class="form-label">Notes</label>
                        <textarea class="form-control" id="newApp-notes" name="Application.Notes" rows="3"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-hf-primary">Add Application</button>
                </div>

            </form>

        </div>
    </div>
</div>
