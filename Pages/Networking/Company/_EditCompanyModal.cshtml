@model HackerFlow.Models.Company
@using HackerFlow.Models

<div class="modal fade" id="editCompanyModal-@Model.Id" tabindex="-1"
     aria-labelledby="editCompanyModalLabel-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content hf-modal">

            <form asp-page-handler="UpdateCompany" method="post">
                <input type="hidden" name="UpdateCompanyInput.Id" value="@Model.Id" />

                <div class="modal-header">
                    <h5 class="modal-title" id="editCompanyModalLabel-@Model.Id">
                        Edit Company — @Model.Name
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="editCompany-name-@Model.Id" class="form-label">Name</label>
                        <input type="text" class="form-control" id="editCompany-name-@Model.Id"
                               name="UpdateCompanyInput.Name" value="@Model.Name" required />
                    </div>

                    <div class="mb-3">
                        <label for="editCompany-website-@Model.Id" class="form-label">Website</label>
                        <input type="url" class="form-control" id="editCompany-website-@Model.Id"
                               name="UpdateCompanyInput.Website" value="@Model.Website" placeholder="https://" />
                    </div>

                    <div class="mb-3">
                        <label for="editCompany-referral-@Model.Id" class="form-label">Referral Chance</label>
                        <select class="form-select" id="editCompany-referral-@Model.Id"
                                name="UpdateCompanyInput.ReferralChance">
                            @foreach (var option in Enum.GetValues<ReferralChance>())
                            {
                                <option value="@option" selected="@(Model.ReferralChance == option)">@option</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="editCompany-description-@Model.Id" class="form-label">Description</label>
                        <textarea class="form-control" id="editCompany-description-@Model.Id"
                                  name="UpdateCompanyInput.Description" rows="3">@Model.Description</textarea>
                    </div>

                    <hr class="border-secondary" />

                    <div class="mb-1">
                        <label class="form-label text-secondary">Connections (@Model.Connections.Count)</label>
                        <input type="text" class="form-control" disabled
                               value="@(Model.Connections.Any() ? string.Join(", ", Model.Connections.Select(c => c.Name)) : "No connections yet")" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-hf-primary">Save Changes</button>
                </div>
            </form>

        </div>
    </div>
</div>
