<div class="modal fade" id="applicationModal" tabindex="-1" aria-labelledby="applicationModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content hf-modal">

            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5 mb-1" id="applicationModalLabel">
                        Application
                    </h2>

                    <p class="text-secondary small mb-0" id="applicationModalSubtitle">
                        Application details
                    </p>
                </div>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <form method="post" id="applicationForm">

                <input type="hidden" name="Application.Id" id="applicationId" />

                <div class="modal-body">

                    <div class="row g-4">

                        <!-- Main application information -->
                        <div class="col-lg-8">

                            <div class="hf-modal-section">

                                <h3 class="hf-modal-section-title">
                                    Application
                                </h3>

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label for="applicationCompany" class="form-label">
                                            Company
                                        </label>

                                        <input type="text" class="form-control hf-input" id="applicationCompany"
                                               name="Application.Company" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="applicationRole" class="form-label">
                                            Role
                                        </label>

                                        <input type="text" class="form-control hf-input" id="applicationRole"
                                               name="Application.Role" />
                                    </div>

                                    <div class="col-12">
                                        <label for="applicationUrl" class="form-label">
                                            Job URL
                                        </label>

                                        <input type="url" class="form-control hf-input" id="applicationUrl"
                                               name="Application.Url" placeholder="https://" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="applicationStatus" class="form-label">
                                            Status
                                        </label>

                                        <select class="form-select hf-input" id="applicationStatus"
                                                name="Application.Status">

                                            <option value="Bookmarked">Bookmarked</option>
                                            <option value="Applying">Applying</option>
                                            <option value="Applied">Applied</option>
                                            <option value="Interviewing">Interviewing</option>
                                            <option value="Negotiating">Negotiating</option>
                                            <option value="Accepted">Accepted</option>

                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="applicationMethod" class="form-label">
                                            Method
                                        </label>

                                        <input type="text" class="form-control hf-input" id="applicationMethod"
                                               name="Application.Method"
                                               placeholder="Company site, LinkedIn, referral..." />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="applicationDateApplied" class="form-label">
                                            Date Applied
                                        </label>

                                        <input type="date" class="form-control hf-input" id="applicationDateApplied"
                                               name="Application.DateApplied" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="applicationFollowUpDate" class="form-label">
                                            Follow-up Date
                                        </label>

                                        <input type="date" class="form-control hf-input" id="applicationFollowUpDate"
                                               name="Application.FollowUpDate" />
                                    </div>

                                    <div class="col-12">
                                        <label for="applicationContact" class="form-label">
                                            Contact
                                        </label>

                                        <input type="text" class="form-control hf-input" id="applicationContact"
                                               name="Application.Contact" placeholder="Name, email, LinkedIn..." />
                                    </div>

                                    <div class="col-12">
                                        <label for="applicationJobDescription" class="form-label">
                                            Job Description
                                        </label>

                                        <textarea class="form-control hf-input" id="applicationJobDescription"
                                                  name="Application.JobDescription" rows="7"></textarea>
                                    </div>

                                    <div class="col-12">
                                        <label for="applicationNotes" class="form-label">
                                            Notes
                                        </label>

                                        <textarea class="form-control hf-input" id="applicationNotes"
                                                  name="Application.Notes" rows="4"></textarea>
                                    </div>

                                </div>

                            </div>

                            <!-- Documents -->
                            <div class="hf-modal-section mt-4">

                                <h3 class="hf-modal-section-title">
                                    Documents
                                </h3>

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label for="applicationResumePath" class="form-label">
                                            Resume
                                        </label>

                                        <input type="text" class="form-control hf-input" id="applicationResumePath"
                                               name="Application.ResumePath" placeholder="Not created" />
                                    </div>

                                    <div class="col-md-6">
                                        <label for="applicationCoverLetterPath" class="form-label">
                                            Cover Letter
                                        </label>

                                        <input type="text" class="form-control hf-input" id="applicationCoverLetterPath"
                                               name="Application.CoverLetterPath" placeholder="Not created" />
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Actions -->
                        <div class="col-lg-4">

                            <div class="hf-modal-section hf-actions-section" id="applicationActionsSection">

                                <h3 class="hf-modal-section-title">
                                    Actions
                                </h3>

                                <div class="d-grid gap-2">

                                    <button type="button" class="btn btn-hf-primary">
                                        Create Resume
                                    </button>

                                    <button type="button" class="btn btn-outline-light">
                                        Create Cover Letter
                                    </button>

                                    <button type="button" class="btn btn-outline-light">
                                        Generate Cover Letter Prompt
                                    </button>

                                    <button type="button" class="btn btn-outline-light">
                                        Open Application Folder
                                    </button>

                                    <button type="button" class="btn btn-outline-light">
                                        Copy Files to Downloads
                                    </button>

                                    <button type="button" class="btn btn-outline-light">
                                        Mark Applied
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-hf-primary" id="applicationSaveButton">
                        Create Application
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>