@page
@model IndexModel

@{
    ViewData["Title"] = "Prompts";
}

<div>
    <!-- Page header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Prompt Manager</h1>
            <p class="text-secondary mb-0">Store and reuse your prompts.</p>
        </div>

        <button type="button" id="newPromptButton" class="btn btn-hf-primary px-4" data-bs-toggle="modal"
                data-bs-target="#newPromptModal">
            New Prompt <span class="ms-1">+</span>
        </button>
    </div>

    <!-- Prompts -->
    @if (!Model.Prompts.Any())
    {
        <div class="card hf-card">
            <div class="card-body text-center text-secondary py-4">No prompts yet.</div>
        </div>
    }
    else
    {
        <div class="card hf-card">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Prompt</th>
                            <th scope="col">Text</th>
                            <th scope="col">Date Created</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prompt in Model.Prompts)
                        {
                            <tr data-bs-toggle="modal" data-bs-target="#detailsPromptModal-@prompt.Id">
                                <td>
                                    <div class="fw-medium">@prompt.Name</div>
                                    <div class="small text-secondary">@prompt.Description</div>
                                </td>
                                <td>
                                    <code class="small text-secondary d-inline-block text-truncate" style="max-width: 320px;"
                                          title="@prompt.PromptString">@prompt.PromptString</code>
                                </td>
                                <td><span class="text-secondary">@prompt.CreatedAt.ToString("MMM d, yyyy")</span></td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-outline-secondary btn-sm me-1" data-bs-toggle="modal"
                                            data-bs-target="#editPromptModal-@prompt.Id">
                                        Edit
                                    </button>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@prompt.Id" class="d-inline"
                                          onsubmit="return confirm('Delete @prompt.Name?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Modals {
    <partial name="_NewPromptModal" />

    @foreach (var prompt in Model.Prompts)
    {
        <partial name="_EditPromptModal" model="prompt" />
        <partial name="_PromptDetailsModal" model="prompt" />
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
}